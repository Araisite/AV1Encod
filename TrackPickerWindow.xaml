<Window x:Class="AV1Encod.TrackPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir les pistes" Width="1040" Height="680" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Une piste = une carte cliquable en entier -->
        <Style x:Key="TrackCard" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,9">
                            <DockPanel>
                                <Border x:Name="Box" DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="5" BorderBrush="#9CA3AF"
                                        BorderThickness="1.5" Background="White" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Tick" Text="✓" Foreground="White" FontWeight="Bold" FontSize="13" Margin="0,-1,0,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interrupteur « garder toutes les pistes » -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="38" Height="22" CornerRadius="11" Background="#D1D5DB" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Petits boutons « pilule » (langues, tout / rien) -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="12" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Bd" Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <DataTemplate x:Key="TrackRowTemplate">
            <CheckBox Style="{StaticResource TrackCard}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="5" Background="#E0E7FF" MinWidth="38" Padding="6,3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LangBadge}" FontWeight="Bold" FontSize="12" Foreground="#3730A3" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border Style="{StaticResource Chip}" Background="#DCFCE7" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="défaut" FontSize="11" Foreground="#166534"/>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="#FEF3C7" Visibility="{Binding IsForced, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="forcé" FontSize="11" Foreground="#92400E"/>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="#FEE2E2" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding WarningText}" FontSize="11" Foreground="#991B1B"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </CheckBox>
        </DataTemplate>

        <!-- Une colonne (audio ou sous-titres) -->
        <DataTemplate x:Key="GroupTemplate">
            <Border Style="{StaticResource Card}" Margin="0" Padding="16,14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" CornerRadius="10" Background="#EEF2FF" Padding="10,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" Foreground="#3730A3"/>
                        </Border>
                        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </DockPanel>
                    <CheckBox DockPanel.Dock="Top" Style="{StaticResource Switch}" IsChecked="{Binding KeepAll}" Margin="0,0,0,10">
                        <TextBlock Text="{Binding KeepAllLabel}" Foreground="{StaticResource TextBrush}"/>
                    </CheckBox>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding QuickPicks}" IsEnabled="{Binding CanPick}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Pill}" Content="{Binding Label}" ToolTip="{Binding Tooltip}" Command="{Binding Command}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding Footer}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TrackRowTemplate}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,2,14">
            <TextBlock Text="Pistes à garder" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock x:Name="FileText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="AudioGroup" ContentTemplate="{StaticResource GroupTemplate}"/>
            <ContentPresenter x:Name="SubsGroup" Grid.Column="2" ContentTemplate="{StaticResource GroupTemplate}"/>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0" MinWidth="96"/>
                <Button x:Name="OkBtn" Content="Valider" IsDefault="True" Style="{StaticResource BtnPrimary}" MinWidth="110" Click="Ok_Click"/>
            </StackPanel>
            <CheckBox x:Name="ApplyAllChk" VerticalAlignment="Center" VerticalContentAlignment="Center">
                <TextBlock x:Name="ApplyAllText" TextWrapping="Wrap"/>
            </CheckBox>
        </DockPanel>
    </Grid>
</Window>
