<Window x:Class="AV1Encod.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Width="780" Height="820" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{StaticResource BgBrush}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="T" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <Button DockPanel.Dock="Bottom" Content="Fermer" IsCancel="True" HorizontalAlignment="Right" MinWidth="100" Margin="0,4,0,0" Click="Close_Click"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- À propos -->
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="Assets/app.ico" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="AV1 Encod" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="CopyrightText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SignatureText" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Link}" Content="Page du projet sur GitHub" Click="OpenRepo_Click" Margin="0,0,18,4"/>
                                <Button Style="{StaticResource Link}" Content="Toutes les versions" Click="OpenReleases_Click" Margin="0,0,18,4"/>
                                <Button Style="{StaticResource Link}" Content="Signaler un problème" Click="OpenIssues_Click" Margin="0,0,18,4"/>
                                <Button Style="{StaticResource Link}" Content="Licence" Click="OpenLicense_Click" Margin="0,0,18,4"/>
                                <Button Style="{StaticResource Link}" Content="Confidentialité" Click="OpenPrivacy_Click" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Mises à jour -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Mises à jour"/>
                        <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Text="Pas encore vérifié."/>
                        <Border x:Name="NotesBox" Visibility="Collapsed" Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,8,0,0" MaxHeight="160">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                            </ScrollViewer>
                        </Border>
                        <ProgressBar x:Name="UpdateProgress" Height="6" Maximum="1" Margin="0,10,0,0" Visibility="Collapsed" BorderThickness="0"
                                     Foreground="{StaticResource AccentBrush}" Background="#E5E7EB"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="CheckBtn" Content="Rechercher une mise à jour" Margin="0,0,8,0" Click="Check_Click"/>
                            <Button x:Name="UpdateBtn" Content="Mettre à jour et redémarrer" Style="{StaticResource BtnPrimary}" Visibility="Collapsed" Click="Update_Click"/>
                        </WrapPanel>
                        <CheckBox x:Name="AutoCheckChk" Content="Vérifier automatiquement au démarrage" Margin="0,12,0,0"
                                  Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Nommage -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Nommage des fichiers encodés"/>
                        <RadioButton x:Name="ShortModeRb" GroupName="Naming" Margin="0,0,0,6" Checked="NamingMode_Changed">
                            <TextBlock TextWrapping="Wrap"><Run Text="Nom court" FontWeight="SemiBold"/><Run Text="  —  Mon.Film.2026.AV1.mkv, Ma.Serie.S01E03.AV1.mkv" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="TemplateModeRb" GroupName="Naming" Checked="NamingMode_Changed">
                            <TextBlock TextWrapping="Wrap"><Run Text="Format Radarr / Sonarr" FontWeight="SemiBold"/><Run Text="  —  source (WEBDL, Bluray…), langues, HDR et codec dans le nom, pour que Radarr / Sonarr les reconnaissent" Foreground="{StaticResource MutedBrush}"/></TextBlock>
                        </RadioButton>

                        <StackPanel x:Name="TemplatePanel" Margin="24,10,0,0">
                            <TextBlock Text="Films" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MovieTemplateBox" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" TextChanged="Template_Changed" GotFocus="Template_GotFocus"/>
                            <TextBlock x:Name="MoviePreview" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="2,4,0,10"/>
                            <TextBlock Text="Séries (fichiers avec SxxEyy)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SeriesTemplateBox" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" TextChanged="Template_Changed" GotFocus="Template_GotFocus"/>
                            <TextBlock x:Name="SeriesPreview" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="2,4,0,10"/>
                            <TextBlock Text="Animes (releases « [Groupe] Titre - 12 », ou séries classées Anime sur TVmaze)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="AnimeTemplateBox" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" TextChanged="Template_Changed" GotFocus="Template_GotFocus"/>
                            <TextBlock x:Name="AnimePreview" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="2,4,0,10"/>

                            <CheckBox x:Name="OnlineChk" Margin="0,0,0,8" Checked="Online_Changed" Unchecked="Online_Changed" VerticalContentAlignment="Top">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Chercher les infos des séries sur TVmaze" FontWeight="SemiBold"/>
                                    <Run Text=" — titre de l'épisode, année de la série, numéro absolu des animes, identifiants TVDB / IMDb. Gratuit et sans compte ; seul le nom de la série est envoyé à api.tvmaze.com." Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </CheckBox>

                            <Expander Header="Jetons disponibles (cliquer pour insérer)" Margin="0,2,0,8" Foreground="{StaticResource TextBrush}">
                                <ItemsControl x:Name="TokensList" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Token}" ToolTip="{Binding Help}" Tag="{Binding Token}" Click="InsertToken_Click"
                                                    FontFamily="Consolas" FontSize="11" Padding="6,2" Margin="0,0,4,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"
                                       Text="Même syntaxe que Radarr / Sonarr : un bloc entre accolades disparaît si l'information manque, son texte autour (crochets, parenthèses, tiret) avec lui. Titre, année, source, édition, groupe et TMDb viennent du nom du fichier source (ou du dossier Radarr) ; langues, audio, HDR et codec, de l'analyse et de l'encodage."/>
                            <Button Content="Rétablir les formats par défaut" HorizontalAlignment="Left" Click="ResetTemplates_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outils -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Outils externes"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8"
                                   Text="AV1 Encod pilote HandBrakeCLI (encodage) et FFmpeg (analyse). Ils s'installent automatiquement avec winget, sans droits administrateur."/>
                        <ItemsControl x:Name="ToolsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Symbol}" Foreground="{Binding Brush}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="InstallStatus" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="InstallBtn" Content="Installer les outils manquants" Margin="0,0,8,0" Click="Install_Click"/>
                            <Button Content="Dossier des journaux" Margin="0,0,8,0" Click="OpenLogs_Click"/>
                            <Button Content="Dossier des réglages" Click="OpenSettingsDir_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Licences -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Licences"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="18">
                            AV1 Encod est un logiciel libre : vous pouvez le redistribuer et le modifier selon les termes de la licence
                            GNU General Public License version 3 ou ultérieure, publiée par la Free Software Foundation.
                            Il est fourni SANS AUCUNE GARANTIE, ni explicite ni implicite (voir le lien « Licence » ci-dessus).
                            <LineBreak/><LineBreak/>
                            Il n'intègre aucun encodeur : il utilise des outils installés séparément, chacun sous sa propre licence —
                            HandBrake (GPL-2.0), FFmpeg (LGPL-2.1 / GPL), SVT-AV1 (BSD-3-Clause-Clear), x265 (GPL-2.0).
                            Dolby Vision et Dolby Atmos sont des marques de Dolby Laboratories.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
